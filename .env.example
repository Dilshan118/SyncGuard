# AI Provider Configuration
# Choose "gemini" (recommended) or "anthropic" or "mock"
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Calendar OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_CALENDAR_ID=primary

# Storage & Paths
DATABASE_PATH=./data/syncguard.db
GOOGLE_TOKEN_PATH=./data/google_token.json
USER_PROFILE_PATH=./config/user_profile.json
AUTH_INFO_PATH=./data/auth_info_baileys

# Application Settings
PORT=3000
LOG_LEVEL=info
BATCH_INTERVAL_CRON="*/3 * * * *"
DAILY_BRIEFING_CRON="30 7 * * *"
